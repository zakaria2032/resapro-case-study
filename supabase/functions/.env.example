# Secrets des Edge Functions (copier vers supabase/functions/.env, jamais versionné). Valeurs factices.
APP_URL=http://localhost:5173

# --- Option A (par défaut) : Stripe SIMULÉ, aucun compte Stripe, aucun appel à Internet ---
# Lancer `npm run stripe:simule` à côté de l'application. Le secret de webhook est libre (partagé par le
# simulateur et la fonction stripe-webhook) : générez une valeur aléatoire.
STRIPE_SECRET_KEY=sk_test_simulation_locale
STRIPE_WEBHOOK_SECRET=whsec_remplacer_par_une_valeur_aleatoire
STRIPE_API_BASE=http://host.docker.internal:12111

# --- Option B : vrai Stripe en mode TEST (compte Stripe gratuit + Stripe CLI) ---
# Supprimer STRIPE_API_BASE, puis renseigner vos clés de TEST (sk_test_…) et le whsec_… donné par `stripe listen`.
# STRIPE_SECRET_KEY=sk_test_remplacer_par_votre_cle_de_test
# STRIPE_WEBHOOK_SECRET=whsec_remplacer_par_le_secret_du_webhook
