# Copier vers .env (jamais versionné). Valeurs factices.
# Seules des valeurs PUBLIQUES peuvent être préfixées VITE_ : elles sont copiées dans le JavaScript du navigateur.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=remplacer-par-la-cle-anon-locale
# La clé service_role ne va JAMAIS ici : elle reste côté serveur (secrets des Edge Functions,
# injectée automatiquement par Supabase sous le nom SUPABASE_SERVICE_ROLE_KEY).
