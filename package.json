{
  "name": "resapro-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "hocs": "python3 scripts/hocs.py",
    "preview": "vite preview",
    "test:deno": "deno check supabase/functions/*/index.ts && deno run --allow-env --allow-net --allow-read --no-lock tests/deno/smoke.ts",
    "stripe:simule": "node scripts/stripe-simule.mjs",
    "test:e2e": "node tests/e2e/parcours-navigateur.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.0.0",
    "playwright-core": "^1.65.1",
    "postgres": "^3.4.9",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.1"
  }
}
